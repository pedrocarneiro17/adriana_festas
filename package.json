{
  "name": "adriana_festas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:local-schema": "node scripts/generate-local-schema.js",
    "predev": "npm run gen:local-schema && prisma generate --schema=prisma/local/schema.prisma",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && tsx prisma/seed-prod.ts && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "db:studio": "prisma studio",
    "db:local:migrate": "npm run gen:local-schema && prisma migrate dev --schema=prisma/local/schema.prisma",
    "db:local:reset": "npm run gen:local-schema && prisma migrate reset --schema=prisma/local/schema.prisma",
    "db:local:seed": "npm run gen:local-schema && prisma generate --schema=prisma/local/schema.prisma && tsx prisma/seed.ts",
    "db:local:studio": "npm run gen:local-schema && prisma studio --schema=prisma/local/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-pdf/renderer": "^4.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
